# Security headers for the static rack and sandboxed cartridges.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/cartridges/*
  Cache-Control: public, max-age=300

/media/*
  Cache-Control: public, max-age=86400

/data/catalog.json
  Cache-Control: no-store

/status/*
  Cache-Control: no-store
